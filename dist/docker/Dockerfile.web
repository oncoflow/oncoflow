# ==============================================================================
# Stage 1: Build TypeScript & Prune DevDependencies (Debian 13 Trixie)
# ==============================================================================
FROM node:26-trixie-slim AS builder

RUN groupadd -g 1002 appuser && \
    useradd -u 1002 -g appuser -m -d /home/appuser -s /usr/sbin/nologin appuser

WORKDIR /build

COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts

COPY web/tsconfig.json web/tsconfig.build.json ./
COPY web/src ./src

RUN npm run build && \
    npm prune --omit=dev && \
    npm cache clean --force

# ==============================================================================
# Stage 2: Minimal Hardened Distroless Runtime (gcr.io/distroless/nodejs24-debian13, UID/GID 1002)
# ==============================================================================
FROM gcr.io/distroless/nodejs24-debian13:latest AS runtime

COPY --from=builder /etc/passwd /etc/group /etc/
COPY --chown=1002:1002 --from=builder /home/appuser /home/appuser

ENV NODE_ENV=production \
    APP_DEV_MODE=false \
    WEB_FAKE_API_FALLBACK=false \
    HOST_WEB=0.0.0.0 \
    PORT_WEB=3000 \
    HOME=/home/appuser \
    PATH="/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

WORKDIR /app

COPY --chown=1002:1002 --from=builder /build/package.json ./package.json
COPY --chown=1002:1002 --from=builder /build/node_modules ./node_modules
COPY --chown=1002:1002 --from=builder /build/dist ./dist
COPY --chown=1002:1002 web/public ./public
COPY --chown=1002:1002 web/styleguide ./styleguide

USER 1002:1002

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT_WEB || 3000) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

ENTRYPOINT ["/nodejs/bin/node"]
CMD ["dist/main.js"]
