# Oncoflow configuration for a Bifrost LLM gateway (see docs/bifrost.md)
# Copy to oncoflow-bifrost.env and adapt. Never commit the real file.

# --- LLM through Bifrost (OpenAI-compatible API) ---
APP_CONFIGLLM_TYPE=Bifrost
# Bifrost container name / hostname on the homelab network
APP_CONFIGLLM_URL=http://bifrost
APP_CONFIGLLM_PORT=8080
APP_CONFIGLLM_URI=/v1
# Models are addressed as <provider>/<model>, providers MUST be local (Ollama, vLLM, llama.cpp...)
APP_CONFIGLLM_MODELS=ollama/qwen3:14b
APP_CONFIGLLM_EMBEDDINGS=ollama/bge-m3
APP_CONFIGLLM_TEMP=0.2
# Optional: Bifrost governance virtual key (sent as x-bf-vk header)
APP_CONFIGLLM_VIRTUAL_KEY=
# Only needed if Bifrost auth is enabled
APP_CONFIGLLM_API_KEY=bifrost

# --- Vector database (ChromaDB server from this compose) ---
APP_DATABASESVECTORIAL_TYPE=chroma
APP_CHOMADB_CLIENT=HttpClient
APP_CHOMADB_HOST=chromadb
APP_CHOMADB_PORT=8000

# --- MongoDB (from this compose) ---
APP_MONGODB_HOST=mongod
APP_MONGODB_PORT=27017
APP_MONGODB_USER=root
APP_MONGODB_PASSWORD=root

# --- Logs ---
APP_LOG_LEVEL=INFO
APP_LOG_TYPE=json
