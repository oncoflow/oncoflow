# ==============================================================================
# Configuration de Production MedDataSyntis (Scaleway L4 24G)
# Copiez ce fichier vers .env.prod et renseignez les secrets OAuth2 GitHub :
#   cp .env.prod.example .env.prod
# ==============================================================================

# ─── Domaine de Base & Images Applicatives (GHCR) ────────────────────────────
# Sous-domaines exposés automatiquement par Caddy :
#   - https://sso.meddatasyntis.bricks-it.fr          (Portail SSO OAuth2 GitHub)
#   - https://oncologic.meddatasyntis.bricks-it.fr    (Web UI M3 — APP_DOMAIN=oncology)
#   - https://sma.meddatasyntis.bricks-it.fr          (Web UI M3 — APP_DOMAIN=sma)
#   - https://oncologic-st.meddatasyntis.bricks-it.fr (Streamlit UI optionnel — APP_DOMAIN=oncology)
#   - https://sma-st.meddatasyntis.bricks-it.fr       (Streamlit UI optionnel — APP_DOMAIN=sma)
PROD_BASE_DOMAIN=meddatasyntis.bricks-it.fr
ONCOFLOW_IMAGE=ghcr.io/oncoflow/oncoflow
ONCOFLOW_API_IMAGE=ghcr.io/oncoflow/oncoflow-api
ONCOFLOW_WEB_IMAGE=ghcr.io/oncoflow/oncoflow-web
ONCOFLOW_TAG=latest

# ─── Authentification GitHub OAuth2 Proxy (SSO multi-sous-domaines) ──────────
# Créer une OAuth App sur GitHub : https://github.com/settings/developers
#   - Homepage URL : https://oncologic.meddatasyntis.bricks-it.fr
#   - Authorization callback URL : https://sso.meddatasyntis.bricks-it.fr/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=votre_github_client_id
OAUTH2_PROXY_CLIENT_SECRET=votre_github_client_secret
OAUTH2_PROXY_REDIRECT_URL=https://sso.meddatasyntis.bricks-it.fr/oauth2/callback

# Générer un secret cookie de 32 octets encodé en base64 URL-safe :
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=remplacer_par_un_secret_base64_32_octets

# Restrictions d'accès GitHub (optionnel mais fortement recommandé en prod) :
# - Restreindre à une organisation GitHub (ex: oncoflow) :
OAUTH2_PROXY_GITHUB_ORG=
# - Restreindre à une équipe GitHub (ex: doctors) :
OAUTH2_PROXY_GITHUB_TEAM=
# - Ou restreindre à une liste d'utilisateurs GitHub séparés par des virgules :
OAUTH2_PROXY_GITHUB_USERS=
# - Domaines email autorisés (* = tous les utilisateurs GitHub autorisés ci-dessus) :
OAUTH2_PROXY_EMAIL_DOMAINS=*

# ─── Paramètres Applicatifs, Logs & Base de Données ──────────────────────────
APP_LANGUAGE=french
APP_LOG_LEVEL=INFO
APP_LOG_TYPE=json
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
APP_MONGODB_USER=root
APP_MONGODB_PASSWORD=root

# ─── Stockage Persistant sur le Filesystem (/data/meddatasyntis) ─────────────
DOCKER_VOLUME_DIRECTORY=/data/meddatasyntis/common
HOST_ONCOLOGIC_DIR=/data/meddatasyntis/oncologic
HOST_SMA_DIR=/data/meddatasyntis/sma

# ─── Paramètres LLM & File de Traitement sur NVIDIA L4 (24 Go VRAM) ──────────
# Fenêtre de contexte de Ornith-1.5-35B-A3B-IQ4_XS (64000 tokens en KV q4_0)
LLM_CTX_SIZE=64000
# Traitement par lot via l'API Cross-Domains (queue.PriorityQueue, 1 par 1 sur GPU L4 24 Go)
APP_ALLOWED_DOMAINS=oncology,sma
APP_QUEUE_ENABLED=true
APP_QUEUE_HARDWARE_PROFILE=l4_24gb
APP_QUEUE_BATCH_SIZE=1
APP_QUEUE_API_URL=http://oncoflow-api:8000
# Clé maître LiteLLM (générée automatiquement par 'make init-prod' : sk-$(openssl rand -hex 32))
LITELLM_MASTER_KEY=sk-remplacer_par_une_cle_hex_32_octets

# ─── Secrets internes MedDataSyntis (générés automatiquement par 'make init-prod') ──
# Jeton partagé exigé par l'API REST (Authorization: Bearer / X-API-Key) :
#   openssl rand -hex 32
APP_API_TOKEN=remplacer_par_un_jeton_hex_32_octets
# Secret injecté par Caddy (X-Oncoflow-Proxy-Secret) pour authentifier les en-têtes OAuth2 :
#   openssl rand -hex 32
APP_PROXY_SECRET=remplacer_par_un_secret_hex_32_octets
# Utilisateurs administrateurs (identifiants GitHub ou emails séparés par des virgules ; vide = tous les utilisateurs authentifiés) :
APP_ADMIN_USERS=
# Interdire l'envoi de données patient vers un serveur LLM externe (doit rester false en prod) :
APP_ALLOW_REMOTE_LLM=false

# ─── Sécurité FastAPI (CORS, Trusted Hosts, En-têtes HTTP, Rate-Limiting & Limites) ──
# Serveur & Réseau Uvicorn
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_API_WORKERS=1
APP_API_TIMEOUT_KEEP_ALIVE=30
APP_API_PROXY_HEADERS=true
APP_API_FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Documentation OpenAPI (/docs, /redoc, /api/v1/openapi.json)
APP_API_DOCS_ENABLED=false
APP_API_DOCS_REQUIRE_AUTH=true

# CORS (Cross-Origin Resource Sharing)
APP_API_CORS_ENABLED=true
APP_API_CORS_ORIGINS=https://oncologic.meddatasyntis.bricks-it.fr,https://sma.meddatasyntis.bricks-it.fr,https://oncologic-st.meddatasyntis.bricks-it.fr,https://sma-st.meddatasyntis.bricks-it.fr
APP_API_CORS_ORIGIN_REGEX=
APP_API_CORS_ALLOW_CREDENTIALS=true
APP_API_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_API_CORS_ALLOW_HEADERS=Authorization,Content-Type,X-API-Key,X-Oncoflow-Domain,X-Oncoflow-User,X-Oncoflow-User-Name,X-Oncoflow-Proxy-Secret,X-Request-ID,Accept,Origin,X-Requested-With
APP_API_CORS_EXPOSE_HEADERS=X-Oncoflow-Domain,X-Request-ID,Content-Disposition
APP_API_CORS_MAX_AGE=600

# Validation Host & Redirection HTTPS
APP_API_TRUSTED_HOSTS=127.0.0.1,localhost,oncoflow-api,*.meddatasyntis.bricks-it.fr
APP_API_FORCE_HTTPS=false

# Compression GZip
APP_API_GZIP_ENABLED=true
APP_API_GZIP_MINIMUM_SIZE=1000

# En-têtes de sécurité HTTP (CSP, HSTS, X-Frame-Options, Referrer-Policy, Permissions-Policy, Cache-Control)
APP_API_SECURITY_HEADERS_ENABLED=true
APP_API_HSTS_ENABLED=true
APP_API_HSTS_MAX_AGE=31536000
APP_API_HSTS_INCLUDE_SUBDOMAINS=true
APP_API_CSP_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
APP_API_FRAME_OPTIONS=DENY
APP_API_REFERRER_POLICY=no-referrer
APP_API_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=()
APP_API_CACHE_CONTROL=no-store, no-cache, must-revalidate, max-age=0
APP_API_COOP_POLICY=same-origin
APP_API_CORP_POLICY=same-origin

# Taille maximale du corps de requête (50 Mo) & Rate-Limiting par IP
APP_API_MAX_BODY_BYTES=52428800
APP_API_RATE_LIMIT_ENABLED=true
APP_API_RATE_LIMIT_REQUESTS=1200
APP_API_RATE_LIMIT_WINDOW_SECONDS=60
